arch=riscv
autoload=0
baudrate=115200
bootdelay=0
quick_boot=false
cpu=k230
vendor=canaan
board=k230_nano3
board_name=k230_nano3
bootcmd=k230_boot spinand linux
# USB ACM is created only in userspace and cannot carry early kernel output.
bootargs=ubi.mtd=rootfs_ubi_a root=ubi0:rootfs rootfstype=ubifs rw rootwait console=ttyS0,115200 earlycon=sbi loglevel=8
SW=DCENT1
